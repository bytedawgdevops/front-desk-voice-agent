# Copy to .env and fill in. .env is gitignored and must stay that way.

# Required — nothing works without these
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional — without these the reply falls back to browser speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional — without these messages are saved but not routed.
# Use the PRODUCTION webhook URL (/webhook/...), not the test one
# (/webhook-test/...), and activate the workflow in n8n.
N8N_WEBHOOK_URL=
N8N_SHARED_TOKEN=

# Local
DB_PATH=data/frontdesk.db
AUDIO_CACHE_DIR=audio_cache
